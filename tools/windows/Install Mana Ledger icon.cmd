@echo off
rem Mana Ledger: puts a Mana Ledger icon on your desktop. Double-click this file once.
rem The PowerShell part below the marker does the work; nothing is installed, and you can
rem delete the icon like any other shortcut.
set "ML_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s = [IO.File]::ReadAllText($env:ML_SELF); $m = '#' + 'POWERSHELL' + '#'; Invoke-Expression $s.Substring($s.IndexOf($m) + $m.Length)"
exit /b
#POWERSHELL#

$ErrorActionPreference = 'Stop'
try {
    # Where Mana Ledger opens: your Codespace. Opening it wakes it up and starts the app.
    $url = 'https://github.com/codespaces/grim-monster-5vxg449p67g43466?editor=web'

    # Save the icon in your user folder (it has to stay somewhere for the shortcut to use it).
    $dir = Join-Path $env:LOCALAPPDATA 'ManaLedger'
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
    $ico = Join-Path $dir 'manaledger.ico'
    [IO.File]::WriteAllBytes($ico, [Convert]::FromBase64String(''))

    # Put the shortcut on the desktop (Windows knows where it is, OneDrive included).
    $desktop = [Environment]::GetFolderPath('Desktop')
    $shortcut = Join-Path $desktop 'Mana Ledger.url'
    $text = "[InternetShortcut]`r`nURL=$url`r`nIconFile=$ico`r`nIconIndex=0`r`n"
    [IO.File]::WriteAllText($shortcut, $text, [Text.Encoding]::Default)

    Write-Host ''
    Write-Host '  Done! The Mana Ledger icon is on your desktop:' -ForegroundColor Green
    Write-Host "  $shortcut"
    Write-Host ''
    Write-Host '  Double-click it to open your Codespace; the app opens in a new tab once it has started.'
} catch {
    Write-Host ''
    Write-Host "  Something went wrong: $_" -ForegroundColor Red
}
Write-Host ''
Read-Host '  Press Enter to close'
